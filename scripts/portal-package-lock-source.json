{
  "name": "@idleproof/portal",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "architecture:gate": "node scripts/architecture-gate.mjs",
    "deployment:gate": "node scripts/deployment-gate.mjs",
    "migrations:gate": "node scripts/migration-ledger-gate.mjs",
    "check": "npm run build && npm run typecheck && npm run test && npm run architecture:gate && npm run deployment:gate && npm run migrations:gate",
    "ci:app": "npm run check && node scripts/bundle-budget.mjs",
    "db:replay": "sh scripts/db-replay-gate.sh",
    "release:smoke": "node scripts/release-smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.95.3",
    "@tanstack/react-router": "1.168.48",
    "@tanstack/react-start": "1.168.48",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "typescript": "5.9.3",
    "vite": "7.2.6",
    "vitest": "4.0.15"
  }
}
