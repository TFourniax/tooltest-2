{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idleproof.dev/spec/idleproof-portal-snapshot-v1.schema.json",
  "title": "IdleProof Portal Snapshot v1",
  "type": "object",
  "required": ["schema", "generatedAt", "project", "task", "change", "understanding", "files", "privacy"],
  "properties": {
    "schema": { "const": "idleproof.portal-snapshot.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "required": ["name", "localId"],
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "localId": { "type": "string", "pattern": "^[a-f0-9]{24}$" }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["summary", "promptDigest", "promptChars", "source", "status", "changed"],
      "properties": {
        "summary": { "type": ["string", "null"], "maxLength": 300 },
        "promptDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "promptChars": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "maxLength": 40 },
        "status": { "type": ["string", "null"] },
        "changed": { "type": "object" }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": ["changeId", "diffSha256"],
      "properties": {
        "changeId": { "type": ["string", "null"], "pattern": "^dwchg_[a-f0-9]{24}$" },
        "diffSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "explanation": { "type": ["object", "null"] },
    "feature": { "type": ["object", "null"] },
    "understanding": { "type": "object" },
    "projectMemory": { "type": ["object", "null"] },
    "files": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 40 },
    "privacy": {
      "type": "object",
      "required": ["sourceCodeIncluded", "rawDiffIncluded", "rawAgentEventsIncluded", "rawPromptIncluded", "secretsRedacted"],
      "properties": {
        "sourceCodeIncluded": { "const": false },
        "rawDiffIncluded": { "const": false },
        "rawAgentEventsIncluded": { "const": false },
        "rawPromptIncluded": { "const": false },
        "secretsRedacted": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
